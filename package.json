{
  "name": "dota-assistente",
  "version": "0.1.0",
  "description": "Assistente de voz para Dota 2 usando Game State Integration (GSI) oficial da Valve",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:turbo": "node src/server.js --turbo",
    "start:record": "node src/server.js --record",
    "start:turbo:record": "node src/server.js --turbo --record",
    "install-cfg": "node scripts/install-cfg.js",
    "simulate": "node scripts/simulate.js",
    "generate-sounds": "node scripts/generate-sounds.js",
    "test-sounds": "node scripts/test-sounds.js"
  }
}
