    { "id": "tormentor", "label": "Tormentor",           "times": [1200],                "lead": 30, "sound": "sounds/tormentor.wav", "enabled": true },
    { "id": "night",     "label": "noite",               "first": 300,  "interval": 600, "enabled": false },
